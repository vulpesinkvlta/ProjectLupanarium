    m_Metadata:
      m_Items: []
  - m_Id: 5259559075
    m_Localized: "Denarius: {0}   \u2022   En iyi tur: {1}\n"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559076
    m_Localized: "Kal\u0131c\u0131 sat\u0131n al\u0131m. \xDCsse d\xF6nd\xFC\u011F\xFCn\xFCzde denarius kazan\u0131rs\u0131n\u0131z."
