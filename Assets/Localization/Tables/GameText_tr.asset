  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: GameText_tr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 50a458f741e05b54aa0306e3995c627b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5133729792
    m_Localized: "Bu ko\u015Fu boyunca ekibe +1 murmillo."
    m_Metadata:
      m_Items: []
  - m_Id: 5238587392
    m_Localized: "+1,5 z\u0131rh; \u2212%15 h\u0131z, +%8 sald\u0131r\u0131 bekleme s\xFCresi."
    m_Metadata:
      m_Items: []
  - m_Id: 5251170304
    m_Localized: "Bu ko\u015Fu boyunca t\xFCm ekibe +%10 can."
    m_Metadata:
      m_Items: []
  - m_Id: 5251170305
    m_Localized: "+%10 can, \u2212%5 hasar."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558912
    m_Localized: "+%12 hasar, \u2212%8 can."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558913
    m_Localized: "+%15 menzil, +%5 hasar, \u2212%15 h\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558914
    m_Localized: "+%15 h\u0131z, \u2212%5 can."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558915
    m_Localized: "Bu ko\u015Fu boyunca t\xFCm ekibe +%8 hasar."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558916
    m_Localized: "\u2212%8 sald\u0131r\u0131 bekleme s\xFCresi, +%8 h\u0131z, \u22120,5 z\u0131rh."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558917
    m_Localized: "01   GLADYAT\xD6RLER"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558918
    m_Localized: "02   B\u0130NALAR"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558919
    m_Localized: "03   CEPHANEL\u0130K"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558920
    m_Localized: "1,6 birim i\xE7indeki herkese z\u0131rha g\xF6re azalan 100 hasar verir; 4 saniyeli\u011Fine \u2212%35 h\u0131z. M\xFCttefikleri de etkiler. Tek y\xFCk."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558921
    m_Localized: "\xDCcretsiz dinlenme: 2:00"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558922
    m_Localized: "L\xFCtuf"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558923
    m_Localized: "\u0130mparatorun L\xFCtfu"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558924
    m_Localized: "L\xFCtuflar"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558925
    m_Localized: Engellenen
    m_Metadata:
      m_Items: []
  - m_Id: 5259558926
    m_Localized: "Bonuslar ve iyile\u015Fme"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558927
    m_Localized: "Sersemletme yetene\u011Fine sahip z\u0131rhl\u0131 secutorlar."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558928
    m_Localized: "Ko\u015Funuz, paran\u0131z, a\xE7\u0131lan birimler ve dizili\u015Fler, binalar, ekipmanlar ve l\xFCtuflar silinecek.\nBu i\u015Flem geri al\u0131namaz."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558929
    m_Localized: "Sava\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558930
    m_Localized: "\xDCsse d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558931
    m_Localized: "EK\u0130B\u0130N\u0130Z"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558932
    m_Localized: Kurt
    m_Metadata:
      m_Items: []
  - m_Id: 5259558933
    m_Localized: "Kurt s\xFCr\xFCs\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558934
    m_Localized: "1,6 birim i\xE7indeki hayatta olan sava\u015F\xE7\u0131lara 150 can kazand\u0131r\u0131r. D\xFC\u015Fmanlar da etkilenir. Tek y\xFCk."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558935
    m_Localized: "T\xFCm gladyat\xF6rlere +1 z\u0131rh; s\u0131n\u0131f ekipman\u0131yla birlikte uygulan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558936
    m_Localized: "T\xFCm gladyat\xF6rlere +%8 can."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558937
    m_Localized: "Bir l\xFCtuf, ard\u0131ndan arenada bir konum se\xE7in"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558938
    m_Localized: "Bir s\xF6zle\u015Fme se\xE7in"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558939
    m_Localized: "Sava\u015Ftan \xF6nce bir dizili\u015F se\xE7in"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558940
    m_Localized: "Se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558941
    m_Localized: "S\xF6zle\u015Fmeyi se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558942
    m_Localized: "Sa\u011F kalan"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558943
    m_Localized: "G\xFC\xE7l\xFC vuru\u015Flar\u0131 olan dayan\u0131kl\u0131 hayvanlar."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558944
    m_Localized: "E\u011Fitim alan\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558945
    m_Localized: "Gladyat\xF6r"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558946
    m_Localized: "GLADYAT\xD6R OKULU"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558947
    m_Localized: "Gladyat\xF6rler"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558948
    m_Localized: Gladius
    m_Metadata:
      m_Items: []
  - m_Id: 5259558949
    m_Localized: Hoplomachus
    m_Metadata:
      m_Items: []
  - m_Id: 5259558950
    m_Localized: 'Denarius: 0'
    m_Metadata:
      m_Items: []
  - m_Id: 5259558951
    m_Localized: "Reklam izleyerek ek \xF6d\xFCl"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558952
    m_Localized: Kapat
    m_Metadata:
      m_Items: []
  - m_Id: 5259558953
    m_Localized: "Hedefi 2 saniyeli\u011Fine %35 yava\u015Flat\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558954
    m_Localized: Silah bileme
    m_Metadata:
      m_Items: []
  - m_Id: 5259558955
    m_Localized: "Ekibiniz burada dinlenecek\n<color=#806F55><size=19>Bir ko\u015Fu ba\u015Flat\u0131n ve sava\u015F\xE7\u0131lar\u0131n\u0131z\u0131 se\xE7in</size></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558956
    m_Localized: "Dizili\u015Fi de\u011Fi\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558957
    m_Localized: "\u0130mparatorluk co\u015Fkusu"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558958
    m_Localized: "Sava\u015F sonu\xE7lar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558959
    m_Localized: "\xD6d\xFCle ge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558960
    m_Localized: "Her seviye: t\xFCm gladyat\xF6rlere +0,5 z\u0131rh ve +2 y\xFCzde puan kritik vuru\u015F \u015Fans\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558961
    m_Localized: "Her seviye: t\xFCm gladyat\xF6rlere +%10 azami can."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558962
    m_Localized: "Her seviye: t\xFCm gladyat\xF6rlere +%8 hasar."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558963
    m_Localized: "Her seviye: retiariuslara +0,1 menzil ve \u2212%3 sald\u0131r\u0131 bekleme s\xFCresi."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558964
    m_Localized: Kaynar katran
    m_Metadata:
      m_Items: []
  - m_Id: 5259558965
    m_Localized: "S\u0131n\u0131f"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558966
    m_Localized: Kama
    m_Metadata:
      m_Items: []
  - m_Id: 5259558967
    m_Localized: Kol
    m_Metadata:
      m_Items: []
  - m_Id: 5259558968
    m_Localized: "\xC7ember"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558969
    m_Localized: Demirhane
    m_Metadata:
      m_Items: []
  - m_Id: 5259558970
    m_Localized: "Sat\u0131n al"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558971
    m_Localized: Revir
    m_Metadata:
      m_Items: []
  - m_Id: 5259558972
    m_Localized: Aslan
    m_Metadata:
      m_Items: []
  - m_Id: 5259558973
    m_Localized: Lorica
    m_Metadata:
      m_Items: []
  - m_Id: 5259558974
    m_Localized: LUPANARIUM
    m_Metadata:
      m_Items: []
  - m_Id: 5259558975
    m_Localized: "Arena aslanlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558976
    m_Localized: "Manip\xFCl"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558977
    m_Localized: "\xC7ok say\u0131da h\u0131zl\u0131 ve z\u0131rhs\u0131z d\xFC\u015Fman."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558978
    m_Localized: Murmillo
    m_Metadata:
      m_Items: []
  - m_Id: 5259558979
    m_Localized: "Murmillolara +1 z\u0131rh ve +%5 can."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558980
    m_Localized: Murmillolara +%10 hasar.
    m_Metadata:
      m_Items: []
  - m_Id: 5259558981
    m_Localized: "\xDCsse d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558982
    m_Localized: Bir ekip kurun
    m_Metadata:
      m_Items: []
  - m_Id: 5259558983
    m_Localized: "Zafer \xF6d\xFCl\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558984
    m_Localized: Ad
    m_Metadata:
      m_Items: []
  - m_Id: 5259558985
    m_Localized: Verilen
    m_Metadata:
      m_Items: []
  - m_Id: 5259558986
    m_Localized: Ekibi tut
    m_Metadata:
      m_Items: []
  - m_Id: 5259558987
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 5259558988
    m_Localized: Ayarlar daha sonra buraya eklenecek.
    m_Metadata:
      m_Items: []
  - m_Id: 5259558989
    m_Localized: "Ko\u015Fuyu ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558990
    m_Localized: "Yeni ko\u015Fu ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558991
    m_Localized: "Dengeli sava\u015F\xE7\u0131lardan olu\u015Fan k\xFC\xE7\xFCk bir ekip."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558992
    m_Localized: "Aktif ko\u015Fu yok"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558993
    m_Localized: "Hedefi 0,45 saniyeli\u011Fine sersemletir."
    m_Metadata:
      m_Items: []
  - m_Id: 5259558994
    m_Localized: "A\xE7\u0131klama"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558995
    m_Localized: "Kilidi a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558996
    m_Localized: "\u0130ptal"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558997
    m_Localized: "HEN\xDCZ EK\u0130P YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558998
    m_Localized: "\u0130lk rakipler"
    m_Metadata:
      m_Items: []
  - m_Id: 5259558999
    m_Localized: Pilum
    m_Metadata:
      m_Items: []
  - m_Id: 5259559000
    m_Localized: "T\xFCm ilerlemeyi s\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559001
    m_Localized: "Al\u0131nan"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559002
    m_Localized: Al
    m_Metadata:
      m_Items: []
  - m_Id: 5259559003
    m_Localized: Takviye
    m_Metadata:
      m_Items: []
  - m_Id: 5259559004
    m_Localized: Posca
    m_Metadata:
      m_Items: []
  - m_Id: 5259559005
    m_Localized: "Takip\xE7iler"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559006
    m_Localized: "Dizili\u015Fsiz devam et"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559007
    m_Localized: "D\xDC\u015EMAN"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559008
    m_Localized: "Yaralar sava\u015Flar aras\u0131nda kal\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559009
    m_Localized: "Reklam: +1 t\xFCketilebilir e\u015Fya"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559010
    m_Localized: 'Reklam: +50 denarius'
    m_Metadata:
      m_Items: []
  - m_Id: 5259559011
    m_Localized: "Reklam: ekibi iyile\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559012
    m_Localized: "Reklam: sava\u015F \xF6d\xFCl\xFCn\xFC ikiye katla"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559013
    m_Localized: Retiarius
    m_Metadata:
      m_Items: []
  - m_Id: 5259559014
    m_Localized: Retiariuslara +%10 hasar ve +0,1 menzil.
    m_Metadata:
      m_Items: []
  - m_Id: 5259559015
    m_Localized: "At\u0131lma"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559016
    m_Localized: "T\xFCm ilerleme s\u0131f\u0131rlans\u0131n m\u0131?"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559017
    m_Localized: "Her \u015Feyi s\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559018
    m_Localized: Secutor
    m_Metadata:
      m_Items: []
  - m_Id: 5259559019
    m_Localized: "A\u011F"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559020
    m_Localized: "1,8 birim i\xE7inde 5 saniyeli\u011Fine +%35 hareket h\u0131z\u0131. D\xFC\u015Fmanlar da etkilenir. Sald\u0131r\u0131lar\u0131 h\u0131zland\u0131rmaz. Tek y\xFCk."
    m_Metadata:
      m_Items: []
  - m_Id: 5259559021
    m_Localized: Scutum
    m_Metadata:
      m_Items: []
  - m_Id: 5259559022
    m_Localized: "Dizili\u015F: yok"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559023
    m_Localized: Doyurucu yahni
    m_Metadata:
      m_Items: []
  - m_Id: 5259559024
    m_Localized: "E\u011E\u0130T\u0130M AVLUSU"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559025
    m_Localized: "\xD6ld\xFCr\xFClen"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559026
    m_Localized: "Ko\u015Fuyu sil"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559027
    m_Localized: "Ko\u015Fuyu sil: geli\u015Ftirmeler korunur.\nTam s\u0131f\u0131rlama: her \u015Feye ba\u015Ftan ba\u015Fla."
    m_Metadata:
      m_Items: []
  - m_Id: 5259559028
    m_Localized: Kalkan darbesi
    m_Metadata:
      m_Items: []
  - m_Id: 5259559029
    m_Localized: "Geli\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559030
    m_Localized: "Hasar \xB7 Z\u0131rh"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559031
    m_Localized: "Hareket h\u0131z\u0131n\u0131 2 saniyeli\u011Fine %35 art\u0131r\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 5259559032
    m_Localized: "E\u011Fitim d\xF6v\xFC\u015F\xFC. Yaln\u0131zca 1\u20133. turlarda kullan\u0131labilir."
    m_Metadata:
      m_Items: []
  - m_Id: 5259559033
    m_Localized: Falanks
    m_Metadata:
      m_Items: []
  - m_Id: 5259559034
    m_Localized: "Merhem \u015Fi\u015Fesi"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559035
    m_Localized: "Dizili\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559036
    m_Localized: Thraex
    m_Metadata:
      m_Items: []
  - m_Id: 5259559037
    m_Localized: "Kaplumba\u011Fa"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559038
    m_Localized: "A\u011F okulu"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559039
    m_Localized: "Arena kalkanlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559040
    m_Localized: "{0}: arenada bir alan se\xE7in. Her iki taraf\u0131 da etkiler!"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559041
    m_Localized: "Sat\u0131n al \xB7 {0} den.\nStok: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559042
    m_Localized: "Kullan \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559043
    m_Localized: Binalar
    m_Metadata:
      m_Items: []
  - m_Id: 5259559044
    m_Localized: Cephanelik
    m_Metadata:
      m_Items: []
  - m_Id: 5259559045
    m_Localized: "Gelecek ko\u015Fular i\xE7in sava\u015F\xE7\u0131lar\u0131n kilidini a\xE7\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559046
    m_Localized: "Okul geli\u015Ftirmeleri t\xFCm ko\u015Fularda ge\xE7erlidir"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559047
    m_Localized: "Sava\u015F\xE7\u0131lar\u0131n\u0131z i\xE7in ekipman sat\u0131n al\u0131n ve ku\u015Fan\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559048
    m_Localized: "Her sat\u0131n al\u0131m bir y\xFCk verir. \xC7emberdeki t\xFCm etkiler her iki tarafa da uygulan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559049
    m_Localized: "KO\u015EU EK\u0130B\u0130  /  {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559050
    m_Localized: "a\xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559051
    m_Localized: '{0}. turdan itibaren'
    m_Metadata:
      m_Items: []
  - m_Id: 5259559052
    m_Localized: '{0} den.'
    m_Metadata:
      m_Items: []
  - m_Id: 5259559053
    m_Localized: "A\xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559054
    m_Localized: "ku\u015Fan\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559055
    m_Localized: depoda
    m_Metadata:
      m_Items: []
  - m_Id: 5259559056
    m_Localized: "Ku\u015Fan"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559057
    m_Localized: "Ko\u015Fuya devam et"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559058
    m_Localized: 'Denarius: {0}'
