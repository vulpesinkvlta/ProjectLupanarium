    m_Metadata:
      m_Items: []
  - m_Id: 5259559068
    m_Localized: "T\xFCm sava\u015F\xE7\u0131lar sa\u011Fl\u0131kl\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5259559069
    m_Localized: "Yaralar sava\u015Flar aras\u0131nda kal\u0131r.\nBayg\u0131n: {0}. Dinlenme s\xFCresi: 2 dakika."
