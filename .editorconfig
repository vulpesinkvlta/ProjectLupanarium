root = true

# Unity и Roslyn читают .cs как UTF-8. Без BOM Visual Studio на русской
# локали открывает файл в CP1251 и при сохранении портит кириллицу
# в комментариях — так уже один раз произошло со всем проектом.
[*.cs]
charset = utf-8-bom
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true

[*.{asmdef,json}]
charset = utf-8
indent_style = space
indent_size = 2

[*.{unity,prefab,asset,meta,mat,anim,controller}]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false
